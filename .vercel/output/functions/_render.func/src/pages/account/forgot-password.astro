---
import BaseLayout from "../../layouts/BaseLayout.astro";

let submitted = false;
let email = "";

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();

  email = String(formData.get("email") ?? "").trim();

  if (email) {
    try {
      const redirectTo = new URL(
        "/account/confirm",
        Astro.url.origin,
      ).toString();

      const { error } = await Astro.locals.supabase.auth.resetPasswordForEmail(
        email,
        {
          redirectTo,
        },
      );

      if (error) {
        console.error("Password reset request failed:", error.message);
      }
    } catch (error) {
      console.error("Password reset request exception:", error);
    }
  }

  submitted = true;
}
---

<BaseLayout>
  <section class="forgot-password-page">
    <div class="forgot-password-panel">
      <div class="forgot-password-header">
        <p class="forgot-password-eyebrow">Mind Arc Games</p>

        <h1>Reset Password</h1>

        {
          submitted ? (
            <p class="forgot-password-message success" role="status">
              If an account exists for this email, we'll send a reset link.
            </p>
          ) : (
            <p class="forgot-password-message">
              Enter the email address associated with your Mind Arc account.
            </p>
          )
        }
      </div>

      {
        !submitted && (
          <form method="POST" class="forgot-password-form">
            <label class="field">
              <span>Email</span>

              <input
                type="email"
                name="email"
                autocomplete="email"
                required
                value={email}
              />
            </label>

            <button type="submit" class="reset-submit">
              Send Reset Link
            </button>
          </form>
        )
      }

      {
        submitted && (
          <div class="submitted-actions">
            <a href="/?login=1" class="primary-link">
              Return to Sign In
            </a>
          </div>
        )
      }

      {
        !submitted && (
          <a href="/?login=1" class="back-link">
            ← Back to Sign In
          </a>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .forgot-password-page {
    min-height: calc(100vh - 90px);

    display: grid;
    place-items: center;

    padding: 3rem 1.5rem;
    box-sizing: border-box;
  }

  .forgot-password-panel {
    width: min(420px, 100%);
    box-sizing: border-box;

    padding: 2.3rem 2rem 2rem;

    background: linear-gradient(
      145deg,
      color-mix(in oklab, var(--surface) 96%, black),
      var(--surface)
    );

    border: 1px solid var(--border);
    border-radius: 14px;

    box-shadow:
      0 28px 90px rgba(0, 0, 0, 0.35),
      0 0 28px color-mix(in oklab, var(--accent) 7%, transparent);
  }

  .forgot-password-header {
    text-align: center;
    margin-bottom: 1.65rem;
  }

  .forgot-password-eyebrow {
    margin: 0 0 0.45rem;

    font-family: "Michroma", sans-serif;
    font-size: 0.58rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;

    opacity: 0.58;
  }

  .forgot-password-header h1 {
    margin: 0;

    font-family: "Michroma", sans-serif;
    font-size: 1.4rem;
    line-height: 1.2;
    letter-spacing: 0.06em;

    color: var(--text);
  }

  .forgot-password-message {
    margin: 0.85rem auto 0;
    max-width: 21rem;

    font-size: 0.84rem;
    line-height: 1.5;

    opacity: 0.72;
  }

  .forgot-password-message.success {
    color: var(--accent);
    opacity: 1;
  }

  .forgot-password-form {
    display: grid;
    gap: 1rem;
  }

  .field {
    display: grid;
    gap: 0.45rem;
  }

  .field span {
    font-family: "Michroma", sans-serif;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;

    opacity: 0.72;
  }

  .field input {
    width: 100%;
    min-height: 46px;
    box-sizing: border-box;

    padding: 0.82rem 0.92rem;

    border: 1px solid var(--border);
    border-radius: 7px;

    background: color-mix(in oklab, var(--surface) 92%, black);

    color: var(--text);

    font: inherit;
    font-size: 0.96rem;

    outline: none;

    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      background-color 0.2s ease;
  }

  .field input:hover {
    border-color: color-mix(in oklab, var(--border) 72%, var(--text));
  }

  .field input:focus {
    border-color: var(--accent);

    box-shadow: 0 0 0 2px color-mix(in oklab, var(--accent) 18%, transparent);

    background: color-mix(in oklab, var(--surface) 94%, black);
  }

  .reset-submit,
  .primary-link {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 100%;
    min-height: 44px;
    box-sizing: border-box;

    padding: 0.8rem 1rem;

    border-radius: 7px;
    border: 1px solid var(--accent);

    background: var(--accent);
    color: var(--bg);

    font-family: "Michroma", sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;

    cursor: pointer;

    transition:
      transform 0.18s ease,
      box-shadow 0.2s ease;
  }

  .reset-submit {
    margin-top: 0.35rem;
  }

  .reset-submit:hover,
  .primary-link:hover {
    transform: translateY(-1px);

    box-shadow: 0 0 16px color-mix(in oklab, var(--accent) 30%, transparent);
  }

  .reset-submit:active,
  .primary-link:active {
    transform: translateY(0);
  }

  .back-link {
    display: block;

    width: fit-content;

    margin: 1rem auto 0;

    color: var(--text);

    font-size: 0.8rem;
    line-height: 1.4;

    text-decoration: none;

    opacity: 0.74;

    transition:
      color 0.2s ease,
      opacity 0.2s ease;
  }

  .back-link:hover {
    color: var(--accent);
    opacity: 1;
  }

  .submitted-actions {
    margin-top: 1.25rem;
  }

  @media (max-width: 480px) {
    .forgot-password-page {
      padding: 2rem 1rem;
    }

    .forgot-password-panel {
      padding: 2.15rem 1.25rem 1.5rem;
      border-radius: 12px;
    }

    .forgot-password-header h1 {
      font-size: 1.3rem;
    }

    .forgot-password-message {
      font-size: 0.8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .field input,
    .reset-submit,
    .primary-link,
    .back-link {
      transition: none;
    }
  }
</style>
