---
import Layout from "../layouts/BaseLayout.astro";

const justVerified = Astro.url.searchParams.get("verified") === "true";

const {
  data: { user },
} = await Astro.locals.supabase.auth.getUser();

let mindArcId: string | null = null;

if (user) {
  const { data: profile, error } = await Astro.locals.supabase
    .from("profiles")
    .select("username")
    .eq("id", user.id)
    .maybeSingle();

  if (error) {
    console.error("Unable to load player profile:", error.message);
  }

  mindArcId = profile?.username ?? null;
}

const showVerificationWelcome = justVerified && !!user;
---

<Layout title="Mind Arc Games | Home">
  <main class="home-page">
    <div class="home-shell">
      <section class="hero">
        <img
          src="../images/mindarcNoplanelogo.png"
          alt="Mind Arc Games"
          class="mindarc-wordmark"
        />
      </section>

      {
        showVerificationWelcome && (
          <div class="verification-welcome">
            <span class="verification-check" aria-hidden="true">
              ✓
            </span>

            <div>
              <strong>Welcome{mindArcId ? `, ${mindArcId}` : ""}.</strong>

              <span>Your Mind Arc account is verified and ready.</span>
            </div>
          </div>
        )
      }

      <section class="panel intro-panel">
        <div class="panel-header">
          <h2>Welcome to Mind Arc Games</h2>
        </div>

        <p>
          Mind Arc Games is an independent creative studio dedicated to building
          atmospheric sci-fi experiences with a unique visual identity,
          responsive gameplay, and a sense of nostalgia.
        </p>

        <p>
          Each project shares a common philosophy: polished gameplay, immersive
          worlds, and experiences designed for player enjoyment.
        </p>
      </section>

      <section class="game-grid">
        <article class="game-card">
          <div class="game-card-image">
            <img
              src="../images/kestrelHero.png"
              alt="Phoenix Vector: Assault"
            />
          </div>

          <div class="game-card-content">
            <h2>Assault</h2>
            <p></p>

            <a href="/assault" class="btn btn-primary"> Explore </a>
          </div>
        </article>

        <article class="game-card">
          <div class="game-card-image">
            <img src="../images/BrandCoreTitlePage.png" alt="Phoenix Vector" />
          </div>

          <div class="game-card-content">
            <h2>Phoenix Vector</h2>
            <p></p>

            <a href="/phoenixvector" class="btn btn-primary"> Explore </a>
          </div>
        </article>
      </section>
    </div>
  </main>
</Layout>

<style>
  :root {
    --panel-border: rgba(103, 232, 249, 0.18);
    --text: #dbe7f5;
    --text-soft: #9fb2c9;
    --heading: #f8fbff;
    --cyan: #67e8f9;
    --shadow: 0 24px 80px rgba(0, 0, 0, 0.45);
  }

  .home-page {
    padding: 2rem 1.25rem;
  }

  .home-shell {
    position: relative;
    z-index: 1;
    max-width: 1120px;
    margin: 0 auto;
  }

  .hero {
    text-align: center;
    padding: 2rem 1rem;
  }

  .mindarc-wordmark {
    width: min(786px, 85vw);
    height: auto;
  }

  .verification-welcome {
    display: flex;
    align-items: center;
    gap: 0.85rem;

    margin: 0 auto 1.5rem;
    padding: 1rem 1.25rem;
    max-width: 720px;

    border: 1px solid rgba(103, 232, 249, 0.28);
    border-radius: 14px;

    background: rgba(10, 18, 36, 0.72);
    color: var(--text);

    backdrop-filter: blur(8px);
  }

  .verification-check {
    display: flex;
    align-items: center;
    justify-content: center;

    flex: 0 0 28px;
    width: 28px;
    height: 28px;

    border: 1px solid var(--cyan);
    border-radius: 50%;

    color: var(--cyan);
    font-weight: 700;
  }

  .verification-welcome div {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .verification-welcome strong {
    color: var(--heading);
  }

  .verification-welcome span {
    font-size: 0.9rem;
    color: var(--text-soft);
  }

  .game-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 1.5rem 0;
  }

  .game-card {
    overflow: hidden;
    border: 1px solid var(--panel-border);
    border-radius: 22px;
    background: linear-gradient(
      180deg,
      rgba(14, 25, 47, 0.88),
      rgba(7, 13, 26, 0.94)
    );
    box-shadow: var(--shadow);
  }

  .game-card-image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #000;
  }

  .game-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .game-card-content {
    padding: 1.5rem;
  }

  .game-card-content h2 {
    margin: 0 0 0.5rem;
    color: var(--heading);
    line-height: 1.1;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .game-card-content p {
    margin: 0 0 1.25rem;
    color: var(--text-soft);
    line-height: 1.6;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 190px;
    padding: 0.95rem 1.4rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
    letter-spacing: 0.04em;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .btn-primary {
    color: #031018;
    background: linear-gradient(135deg, var(--cyan), #a5f3fc);
    box-shadow: 0 10px 30px rgba(103, 232, 249, 0.22);
  }

  .btn-primary:hover {
    box-shadow: 0 16px 34px rgba(103, 232, 249, 0.3);
  }

  .panel {
    position: relative;
    margin-top: 1.5rem;
    padding: 2rem;
    border: 1px solid var(--panel-border);
    border-radius: 22px;
    background: linear-gradient(
      180deg,
      rgba(14, 25, 47, 0.88),
      rgba(7, 13, 26, 0.94)
    );
    box-shadow: var(--shadow);
    backdrop-filter: blur(10px);
  }

  .panel::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 22px;
    padding: 1px;
    background: linear-gradient(
      135deg,
      rgba(103, 232, 249, 0.35),
      rgba(255, 200, 87, 0.18),
      rgba(103, 232, 249, 0.1)
    );
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  .panel-header {
    margin-bottom: 1rem;
  }

  .panel h2 {
    margin: 0;
    color: var(--heading);
    font-size: clamp(1.6rem, 3vw, 2.3rem);
    line-height: 1.1;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .panel p {
    color: var(--text);
    line-height: 1.85;
    font-size: 1rem;
  }

  @media (max-width: 768px) {
    .home-page {
      padding: 2rem 1rem 4rem;
    }

    .hero {
      padding: 1.5rem 0.25rem 2rem;
    }

    .game-grid {
      grid-template-columns: 1fr;
    }

    .game-card,
    .panel {
      border-radius: 18px;
    }

    .panel {
      padding: 1.4rem;
    }

    .panel::before {
      border-radius: 18px;
    }

    .btn {
      width: 100%;
      min-width: 0;
    }
  }
</style>
