---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import { createSupabaseServerClient } from "../../lib/supabase/server";

let errorMessage = "";

if (Astro.request.method === "POST") {
  const contentType = Astro.request.headers.get("content-type") ?? "";

  if (
    !contentType.includes("application/x-www-form-urlencoded") &&
    !contentType.includes("multipart/form-data")
  ) {
    console.error("Invalid reset-password Content-Type:", contentType);

    return Astro.redirect(
      "/?login=error&reason=password-reset-session-expired",
    );
  }

  const formData = await Astro.request.formData();

  const password = String(formData.get("password") ?? "");
  const confirmPassword = String(formData.get("confirmPassword") ?? "");

  if (!password || !confirmPassword) {
    errorMessage = "Enter and confirm your new password.";
  } else if (password !== confirmPassword) {
    errorMessage = "Passwords do not match.";
  } else if (password.length < 8) {
    errorMessage = "Your new password must be at least 8 characters.";
  } else {
    const supabase = createSupabaseServerClient({
      request: Astro.request,
      cookies: Astro.cookies,
    });

    const {
      data: { user },
      error: userError,
    } = await supabase.auth.getUser();

    if (userError || !user) {
      console.error(
        "Password reset session unavailable:",
        userError?.message ?? "No authenticated recovery user.",
      );

      return Astro.redirect(
        "/?login=error&reason=password-reset-session-expired",
      );
    }

    const { error } = await supabase.auth.updateUser({
      password,
    });

    if (error) {
      console.error("Password update failed:", error.message);

      errorMessage = "We couldn't update your password. Please try again.";
    } else {
      const { error: signOutError } = await supabase.auth.signOut();

      if (signOutError) {
        console.error("Post-reset sign out failed:", signOutError.message);
      }

      return Astro.redirect("/?login=success&reason=password-updated");
    }
  }
}
---

<BaseLayout>
  <section class="reset-password-page">
    <div class="reset-password-panel">
      <div class="reset-password-header">
        <p class="reset-password-eyebrow">Mind Arc Games</p>

        <h1>Reset Password</h1>

        <p class="reset-password-message">
          Choose a new password for your Mind Arc account.
        </p>

        {
          errorMessage && (
            <p class="reset-password-error" role="alert">
              {errorMessage}
            </p>
          )
        }
      </div>

      <form method="POST" class="reset-password-form">
        <label class="field">
          <span>New Password</span>

          <input
            type="password"
            name="password"
            autocomplete="new-password"
            minlength="8"
            required
          />
        </label>

        <label class="field">
          <span>Confirm Password</span>

          <input
            type="password"
            name="confirmPassword"
            autocomplete="new-password"
            minlength="8"
            required
          />
        </label>

        <button type="submit" class="reset-submit"> Update Password </button>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .reset-password-page {
    min-height: calc(100vh - 90px);

    display: grid;
    place-items: center;

    padding: 3rem 1.5rem;
    box-sizing: border-box;
  }

  .reset-password-panel {
    width: min(420px, 100%);
    box-sizing: border-box;

    padding: 2.3rem 2rem 2rem;

    background: linear-gradient(
      145deg,
      color-mix(in oklab, var(--surface) 96%, black),
      var(--surface)
    );

    border: 1px solid var(--border);
    border-radius: 14px;

    box-shadow:
      0 28px 90px rgba(0, 0, 0, 0.35),
      0 0 28px color-mix(in oklab, var(--accent) 7%, transparent);
  }

  .reset-password-header {
    text-align: center;
    margin-bottom: 1.65rem;
  }

  .reset-password-eyebrow {
    margin: 0 0 0.45rem;

    font-family: "Michroma", sans-serif;
    font-size: 0.58rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;

    opacity: 0.58;
  }

  .reset-password-header h1 {
    margin: 0;

    font-family: "Michroma", sans-serif;
    font-size: 1.4rem;
    line-height: 1.2;
    letter-spacing: 0.06em;

    color: var(--text);
  }

  .reset-password-message,
  .reset-password-error {
    margin: 0.85rem auto 0;
    max-width: 21rem;

    font-size: 0.84rem;
    line-height: 1.5;
  }

  .reset-password-message {
    opacity: 0.72;
  }

  .reset-password-error {
    color: #ff6b6b;
  }

  .reset-password-form {
    display: grid;
    gap: 1rem;
  }

  .field {
    display: grid;
    gap: 0.45rem;
  }

  .field span {
    font-family: "Michroma", sans-serif;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;

    opacity: 0.72;
  }

  .field input {
    width: 100%;
    min-height: 46px;
    box-sizing: border-box;

    padding: 0.82rem 0.92rem;

    border: 1px solid var(--border);
    border-radius: 7px;

    background: color-mix(in oklab, var(--surface) 92%, black);

    color: var(--text);

    font: inherit;
    font-size: 0.96rem;

    outline: none;

    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      background-color 0.2s ease;
  }

  .field input:hover {
    border-color: color-mix(in oklab, var(--border) 72%, var(--text));
  }

  .field input:focus {
    border-color: var(--accent);

    box-shadow: 0 0 0 2px color-mix(in oklab, var(--accent) 18%, transparent);

    background: color-mix(in oklab, var(--surface) 94%, black);
  }

  .reset-submit {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 100%;
    min-height: 44px;
    box-sizing: border-box;

    margin-top: 0.35rem;
    padding: 0.8rem 1rem;

    border: 1px solid var(--accent);
    border-radius: 7px;

    background: var(--accent);
    color: var(--bg);

    font-family: "Michroma", sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;

    cursor: pointer;

    transition:
      transform 0.18s ease,
      box-shadow 0.2s ease;
  }

  .reset-submit:hover {
    transform: translateY(-1px);

    box-shadow: 0 0 16px color-mix(in oklab, var(--accent) 30%, transparent);
  }

  .reset-submit:active {
    transform: translateY(0);
  }

  @media (max-width: 480px) {
    .reset-password-page {
      padding: 2rem 1rem;
    }

    .reset-password-panel {
      padding: 2.15rem 1.25rem 1.5rem;
      border-radius: 12px;
    }

    .reset-password-header h1 {
      font-size: 1.3rem;
    }

    .reset-password-message,
    .reset-password-error {
      font-size: 0.8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .field input,
    .reset-submit {
      transition: none;
    }
  }
</style>
